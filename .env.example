DRUGSHIELD_RUNTIME_DIR=data/runtime
DRUGSHIELD_DATABASE_PATH=data/runtime/drugshield.sqlite3
DRUGSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DRUGSHIELD_ENV=development
DRUGSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1
# Generate both secrets locally; never commit real values.
DRUGSHIELD_AUTH_SECRET=SET_ME
DRUGSHIELD_DATA_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
DRUGSHIELD_USERS_JSON=[]
DRUGSHIELD_SESSION_TTL_SECONDS=1800
DRUGSHIELD_RETENTION_DAYS=90
DRUGSHIELD_BACKUP_DIR=data/backups
DRUGSHIELD_MAX_REQUEST_BYTES=31457280
DRUG_TOPIC_REVIEW_THRESHOLD=0.75
IMAGE_DRUG_REVIEW_THRESHOLD=0.95
SLANG_REVIEW_THRESHOLD=0.35
MAX_ATTACHMENT_BYTES=12582912
MAX_ATTACHMENTS_PER_MESSAGE=5
MAX_TOTAL_ATTACHMENT_BYTES=26214400
