# DrugShield AI - Environment Configuration
# ==========================================

# Network Interface & Port Configuration
# Binds to 0.0.0.0 (all IPv4 interfaces) for LAN / external access
HOST=0.0.0.0

# Custom port (avoiding standard ports like 8080, 5000, 4200, 3000)
PORT=8090

# Telegram OSINT Credentials (Optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=drugshield_session
